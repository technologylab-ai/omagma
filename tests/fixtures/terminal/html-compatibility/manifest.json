  "decisionNotes": {
    "pendingPolicyCases": [],
    "doctypePreservation": "An absent doctype must remain absent. DOM equivalence includes document.compatMode for no-doctype/table and standards/table controls.",
    "opaqueText": "mustRetain is raw source preservation, except envelope repair and stale encoding meta removal. CID-like strings in comments/raw text are not actual resource references.",
    "bodyInsertion": "The note and original header precede the first original body token even if literal body opens occur only later. A late head style stays in its browser-recovered parent.",
    "concatenatedDocuments": "Accept browser-deterministic concatenated envelopes in one HTML leaf; this does not change backend rejection of multiple alternative MIME presentation bodies.",
    "unfinishedBodyTails": "Accept unfinished quote/comment/raw-style tails after a safe body insertion point is known. Copy the exact tail to EOF; do not append guessed envelope closers inside it or classify fake body/image tokens as markup.",
    "unfinishedHeadBoundaries": "Refuse OriginalHtmlUnavailable when unfinished quoted/raw head content prevents finding a safe insertion point outside head. The preserved original remains immutable; the error is a boundary availability failure, not general HTML validation.",
    "historicalPendingNames": "The quote-EOF, head-style-EOF, and script-double-escape files retain their initial pending- prefixes, but expectedOutcome now records their final accept/reject policies. No pending case outcomes remain.",
    "scriptDoubleEscape": "Accept with tracked script escaped/double-escaped states; independent Chromium candidate1 evidence confirmed zero errors and original browser DOM/CSS equivalence."
  },
  "sources": [
    {
      "title": "HTML Standard: parsing and tokenizer states",
      "url": "https://html.spec.whatwg.org/multipage/parsing.html"
    },
    {
      "title": "WPT tree construction: repeated bodies and late root attributes",
      "url": "https://github.com/web-platform-tests/wpt/blob/master/html/syntax/parsing/resources/tests2.dat"
    },
    {
      "title": "WPT tree construction: repeated heads and quirks paragraph/table parsing",
